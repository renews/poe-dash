    "bufferutil": "^4.1.0",
    "chokidar": "^6.0.0",
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "lucide": "^1.68.0",
    "lucide-react": "^1.68.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
